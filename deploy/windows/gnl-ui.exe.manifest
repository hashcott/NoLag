<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  An external manifest, sitting next to gnl-ui.exe, rather than one compiled
  into the binary: embedding it needs a resource compiler that does not run on
  the machine this is built on, and Windows reads <name>.exe.manifest for a
  binary that carries none. The installer copies both.

  Three things are declared here and all three matter:

    - Common Controls 6. The tray menu will not create without it.
    - Per-monitor DPI awareness. Without it the icon is drawn at 96 dpi and
      scaled up by Windows, which on the high-resolution screen a gaming machine
      tends to have looks blurred.
    - asInvoker. The interface holds no privilege and must not ask for any:
      everything privileged is in the service. A UAC prompt at logon for a tray
      icon would also be the fastest way to have somebody uninstall this.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="GameNoLag.Tray" version="1.0.0.0" processorArchitecture="amd64"/>
  <description>GameNoLag</description>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="amd64"
                        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- 10 and 11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- 8.1 -->
    </application>
  </compatibility>
</assembly>
